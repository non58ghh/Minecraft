			},
			"animations": {
				"idle": "animation.aicivilization.agent.idle",
				"walk": "animation.aicivilization.agent.walk"
			},
			"scripts": {
				"animate": [
					"idle",
					{ "walk": "query.modified_distance_moved > 0.01" }
				]
			},
			"render_controllers": ["controller.render.aicivilization.agent"]
		}
	}
}
